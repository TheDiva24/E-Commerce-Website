<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutomationExercise - Full API Test Suite" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Products API Tests">
        <classes>
            <class name="com.automationexercise.api.API01_GetAllProductsListTest"/>
            <class name="com.automationexercise.api.API02_PostToProductsListTest"/>
            <class name="com.automationexercise.api.API03_GetAllBrandsListTest"/>
            <class name="com.automationexercise.api.API04_PutToBrandsListTest"/>
        </classes>
    </test>

    <test name="Search API Tests">
        <classes>
            <class name="com.automationexercise.api.API05_PostSearchProductTest"/>
            <class name="com.automationexercise.api.API06_PostSearchProductMissingParamTest"/>
        </classes>
    </test>

    <test name="Login Verification API Tests">
        <classes>
            <class name="com.automationexercise.api.API07_PostVerifyLoginValidTest"/>
            <class name="com.automationexercise.api.API08_PostVerifyLoginMissingEmailTest"/>
            <class name="com.automationexercise.api.API09_DeleteVerifyLoginTest"/>
            <class name="com.automationexercise.api.API10_PostVerifyLoginInvalidTest"/>
        </classes>
    </test>

    <test name="User Account API Tests">
        <classes>
            <class name="com.automationexercise.api.API11_PostCreateUserAccountTest"/>
            <class name="com.automationexercise.api.API12_DeleteUserAccountTest"/>
            <class name="com.automationexercise.api.API13_PutUpdateUserAccountTest"/>
            <class name="com.automationexercise.api.API14_GetUserDetailByEmailTest"/>
        </classes>
    </test>

</suite>

# ─────────────────────────────────────────────
#  AutomationExercise – .gitignore
# ─────────────────────────────────────────────

# Maven build output (too large for GitHub – uploaded as target.rar instead)
target/

# Keep the compressed archive so new users can extract the Allure history
!target.rar

# IDE – IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# IDE – Eclipse
.classpath
.project
.settings/
bin/

# IDE – VS Code
.vscode/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# TestNG output (regenerated on each run)
test-output/

# Log files
*.log
logs/

# Allure temporary files
allure-results/
allure-report/

# Environment-specific files
*.env

# ─────────────────────────────────────────────
# DO NOT ignore:
#   - pom.xml
#   - testng.xml / testng-api.xml
#   - run.bat / run.ps1
#   - src/ (all source code)
#   - target.rar (compressed build artifacts)
# ─────────────────────────────────────────────
